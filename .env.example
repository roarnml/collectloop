# Safe placeholders only. Copy to .env locally after onboarding.
# Never put real credentials in this file or commit a populated .env.

# Frontend
# Django API root (the frontend appends /v1/...). Use the Railway URL in production.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
# Currency for new requests. It must match the business's Open Payments wallet.
NEXT_PUBLIC_DEFAULT_CURRENCY=NGN

# Backend
DJANGO_SECRET_KEY=replace-locally
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://collectloop:replace-locally@localhost:5432/collectloop

# Open Payments
# Populate only with values supplied by the approved hackathon test environment.
OPEN_PAYMENTS_BASE_URL=
OPEN_PAYMENTS_CLIENT_ID=
OPEN_PAYMENTS_KEY_ID=
OPEN_PAYMENTS_PRIVATE_KEY_PATH=
OPEN_PAYMENTS_WEBHOOK_SECRET=
